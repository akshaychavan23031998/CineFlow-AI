{
  "name": "@cineflow/media-worker",
  "version": "0.1.0",
  "private": true,
  "description": "CineFlow AI isolated media-processing worker.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
